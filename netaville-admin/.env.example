# Copy to .env.local and fill in. Committed as documentation; holds no secrets.
#
# Local (docker compose up -d db) — password matches docker-compose.yml:
#   postgresql://sperovski:netaville-local-dev-only@localhost:5432/netaville
# Neon: the pooled connection string from the project dashboard. It already
# ends in ?sslmode=require, which lib/db.ts keys off to enable TLS.
DATABASE_URL=

# --- Auth (required in production) -------------------------------------------
# Signs the mobile app's access tokens and the panel's session cookie. Anyone
# who knows this can mint a token for any account, so it is the one value here
# that genuinely must not leak.
#   openssl rand -base64 48
# Unset in development falls back to a key that is public in this repository,
# with a warning. Unset in production is a hard failure, on purpose.
APP_JWT_SECRET=

# The admin panel password. Unset in development falls back to 'netaville';
# unset in production refuses every sign-in rather than accept that default.
ADMIN_PASSWORD=

# --- Email (verification codes) --------------------------------------------
# Registration sends a six-digit code to the address before creating the
# account. With RESEND_API_KEY unset the code is printed to the server console
# instead — fine for local dev, not for anything real.
#   Get a key at https://resend.com → API Keys
# MAIL_FROM must be an address on a domain verified with Resend. Left unset it
# uses Resend's shared sandbox sender, which only delivers to the account owner.
RESEND_API_KEY=
MAIL_FROM=Netaville <no-reply@yourdomain.example>

# --- Canva (optional) --------------------------------------------------------
# Lets staff design TV posters and video ads in Canva from the TV displays
# screen. Leave blank and the Canva buttons stay hidden.
#
# Create an integration at https://www.canva.com/developers/integrations:
#   - Add the scopes: design:content:read, design:content:write,
#     design:meta:read
#   - Set the redirect URL to CANVA_REDIRECT_URI below (add the production URL
#     too when you deploy)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/callback

# 32+ random chars. Encrypts the stored Canva refresh token at rest. If unset,
# the token is stored in plain text (fine for local dev, set it in production).
CANVA_TOKEN_KEY=

# Copy to .env.local for development. Committed as documentation.
#
# Where the admin panel's API lives.
#
# Development
#   Leave it unset and the app derives the host from Metro, so the simulator and
#   a phone on the same Wi-Fi both work with no edit. Set it explicitly when
#   that guess is wrong — on the simulator, http://localhost:3000 is the most
#   reliable, because it survives your Mac's IP changing.
#
# Release / TestFlight / App Store
#   This MUST be set, and it MUST be https. App Transport Security is on
#   (NSAllowsArbitraryLoads is false in Info.plist), so iOS blocks any plain
#   http:// request from a release build outright — the app would simply report
#   that it cannot reach Netaville, with no other clue.
#
#   EXPO_PUBLIC_API_URL=https://api.netaville.example
#
# EXPO_PUBLIC_* values are inlined into the bundle at build time, so a change
# here needs Metro restarted (dev) or a fresh build (release).
EXPO_PUBLIC_API_URL=
